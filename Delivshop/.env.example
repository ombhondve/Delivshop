# Delivshop Mobile App Environment Configuration
# Expo will only bundle variables prefixed with EXPO_PUBLIC_ into the mobile client.
# NEVER store database credentials, signing keys, or server secrets in this application.

# For physical devices running Expo Go, use your computer's local network IP (e.g. 192.168.1.6).
# If left blank, client.ts will automatically resolve the Metro host IP in development.
EXPO_PUBLIC_API_URL=http://192.168.1.6:5000/api
