# Delivshop Mobile App Environment Configuration
# Expo will only bundle variables prefixed with EXPO_PUBLIC_ into the mobile client.
# NEVER store database credentials, signing keys, or server secrets in this application.

# Default: Verified Production Deployed HTTPS Backend (Connected to Neon DB)
EXPO_PUBLIC_API_URL=https://delivshop-vuw7.vercel.app/api

# For local development against a locally running Delivshop_Backend server:
# EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:5000/api
# Or leave commented out to let client.ts auto-detect your Metro dev machine IP in Expo Go.
