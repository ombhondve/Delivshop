# Delivshop Backend Environment Configuration
# All sensitive credentials and keys must remain strictly in this server environment.
# Never commit real secrets or credentials to version control.

NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivshop_db

# CORS Allowed Origins (Comma-separated list)
# e.g., web frontend, Vercel production frontend, and Expo mobile dev server
ALLOWED_ORIGINS=https://delivshop.vercel.app,http://localhost:5173,http://localhost:8081,http://localhost:19006

# Authentication & Cryptography
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
