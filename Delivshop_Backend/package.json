{
  "name": "delivshop-backend",
  "version": "1.0.0",
  "description": "Secure Delivshop API Server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');const s=path.join('src','database','migrations'),d=path.join('dist','database','migrations');if(fs.existsSync(s)){fs.mkdirSync(d,{recursive:true});fs.readdirSync(s).filter(f=>f.endsWith('.sql')).forEach(f=>fs.copyFileSync(path.join(s,f),path.join(d,f)));}\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:status": "tsx src/database/status.ts",
    "seed": "tsx src/database/seed.ts",
    "admin:provision": "tsx src/database/provision-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.3",
    "typescript": "^5.9.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "vitest": "^3.0.8"
  },
  "private": true
}
